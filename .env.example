# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Список Telegram ID пользователей, которым разрешен доступ к боту (через запятую).
# Если оставить пустым, доступ будет открыт всем (не рекомендуется).
# Узнать свой ID можно у @userinfobot
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Ключ OpenRouter API (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Опциональный список предпочтительных бесплатных моделей OpenRouter (через запятую)
# Бот также автоматически получает все актуальные бесплатные модели с openrouter.ai
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-thinking-exp:free,google/gemini-2.0-flash-001:free,mistralai/mistral-small-3.2-24b-instruct:free,qwen/qwen-2.5-72b-instruct:free,deepseek/deepseek-r1:free

# Ключ Groq API для мгновенной транскрибации через Whisper-Large-v3 (получить бесплатно на https://console.groq.com/keys)
# Если не указан или превышен лимит, бот автоматически использует локальный faster-whisper
GROQ_API_KEY=your_groq_api_key_here

# Модель для локального Whisper (если Groq не используется или недоступен):
# tiny, base, small, medium (для 6 ГБ RAM рекомендуется small или medium)
LOCAL_WHISPER_MODEL=small

# Часовой пояс (по умолчанию Екатеринбург, UTC+5 / YEKT)
TIMEZONE=Asia/Yekaterinburg

# За сколько минут по умолчанию напоминать до наступления срока задачи (0 = ровно в срок, 15 = за 15 минут)
DEFAULT_REMINDER_LEAD_MINUTES=15

# Время ежедневных отчетов (в часовом поясе TIMEZONE)
MORNING_BRIEFING_TIME=09:00
EVENING_BRIEFING_TIME=21:00

# Путь к файлу базы данных SQLite
DB_PATH=data/myzapis.db

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
